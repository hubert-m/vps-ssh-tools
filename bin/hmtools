#!/usr/bin/env bash
# hmtools — interaktywny shell narzędzi VPS (OpenLiteSpeed / CyberPanel)
set -euo pipefail

# Rozwiąż katalog instalacji (symlink-safe)
_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${_SOURCE}" ]]; do
  _DIR="$(cd "$(dirname "${_SOURCE}")" && pwd)"
  _SOURCE="$(readlink "${_SOURCE}")"
  [[ "${_SOURCE}" != /* ]] && _SOURCE="${_DIR}/${_SOURCE}"
done
_BIN_DIR="$(cd "$(dirname "${_SOURCE}")" && pwd)"
HMTOOLS_ROOT="$(cd "${_BIN_DIR}/.." && pwd)"
export HMTOOLS_ROOT
export HMTOOLS_CONF="${HMTOOLS_CONF:-${HMTOOLS_ROOT}/config/hmtools.conf}"

# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/lib/common.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/lib/help.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/lib/complete.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/lib/detect.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/lib/size.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/lib/db.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/lib/sites.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/lib/rclone_drive.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/lib/backup.sh"

# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/commands/webs.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/commands/site_shell.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/commands/backup.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/commands/disk.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/commands/ols.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/commands/ssl.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/commands/mysql.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/commands/health.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/commands/cron.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/commands/pm2.sh"

hm_require_root
hm_load_config
hm_detect_all
hm_log_init

hm_dispatch() {
  local cmd="${1:-}"
  shift || true

  if [[ -n "${cmd}" ]]; then
    hm_log_cmd "${cmd}${*:+ $*}"
  fi

  # W kontekście strony — lokalne komendy
  if [[ -n "${HM_SITE_DOMAIN}" ]]; then
    case "${cmd}" in
      info)   cmd_site_info; return ;;
      size)   cmd_site_size; return ;;
      dbs|databases) cmd_site_dbs; return ;;
      ssl)    cmd_site_ssl; return ;;
      php)    cmd_site_php; return ;;
      logs|log) cmd_site_logs "$@"; return ;;
      backup)
        if [[ "${1:-}" == "" ]]; then
          cmd_site_backup
        else
          cmd_backup "$@"
        fi
        return
        ;;
      clean)  cmd_site_clean; return ;;
      cron|crons) cmd_cron "$@"; return ;;
      pm2|node|apps) cmd_pm2 "$@"; return ;;
      help|?) hm_cmd_help "$@"; return ;;
      exit|quit|back|.. )
        hm_ok "Wyjście z kontekstu ${HM_SITE_DOMAIN}."
        hm_clear_site_context
        return
        ;;
    esac
  fi

  case "${cmd}" in
    "" ) return 0 ;;
    webs|sites|list) cmd_webs "$@" ;;
    use|enter|cd)    cmd_use "$@" ;;
    backup)          cmd_backup "$@" ;;
    disk|df)         cmd_disk "$@" ;;
    ols|lsws)        cmd_ols "$@" ;;
    ssl)             cmd_ssl "$@" ;;
    mysql|dbs|db)    cmd_mysql "$@" ;;
    php)             cmd_php "$@" ;;
    health|status)   cmd_health "$@" ;;
    applog|selflog|hmlog) cmd_applog "$@" ;;
    cron|crons)      cmd_cron "$@" ;;
    pm2|node|apps)   cmd_pm2 "$@" ;;
    detect|env)      hm_detect_print ;;
    help|h|\?)       hm_cmd_help "$@" ;;
    update-hmtools)
      local force=0
      local a
      for a in "$@"; do
        case "${a}" in
          --force|-f) force=1 ;;
          --help|-h)
            echo "Użycie: update-hmtools [--force]"
            echo "  Porównuje /hm-tools/VERSION z najnowszym tagiem GitHuba."
            echo "  Aktualizuje tylko gdy jest nowsza wersja (albo --force)."
            return 0
            ;;
        esac
      done
      hm_info "Sprawdzanie aktualizacji hmtools..."
      local branch="${HMTOOLS_BRANCH:-develop}"
      local url="https://raw.githubusercontent.com/hubert-m/vps-ssh-tools/${branch}/install.sh"
      if [[ "${force}" -eq 1 ]]; then
        HMTOOLS_FORCE=1 curl -fsSL "${url}" | bash
      else
        curl -fsSL "${url}" | bash
      fi
      hm_ok "Po update-hmtools uruchom ponownie hmtools, jeśli jesteś w REPL."
      ;;
    version|ver)
      local cur latest
      cur="$(hm_installed_version)"
      [[ -n "${cur}" ]] || cur="?"
      echo "Zainstalowana: ${cur}"
      latest="$(hm_latest_remote_version)"
      if [[ -n "${latest}" ]]; then
        echo "Najnowsza:     ${latest}"
        if hm_version_is_newer "${cur}" "${latest}"; then
          hm_warn "Dostępna aktualizacja: ${cur} → ${latest}"
          hm_warn "curl -fsSL https://raw.githubusercontent.com/${HMTOOLS_REPO:-hubert-m/vps-ssh-tools}/${HMTOOLS_BRANCH:-develop}/install.sh | bash"
          hm_warn "Albo: update-hmtools"
        else
          hm_ok "Jesteś na najnowszej wersji."
        fi
      else
        hm_warn "Nie udało się sprawdzić najnowszej wersji na GitHubie."
      fi
      hm_print_changelog "${cur}" "Co zawiera zainstalowana wersja (${cur})"
      ;;
    uninstall-hmtools)
      cmd_uninstall_hmtools "$@"
      ;;
    exit|quit|q)     return 99 ;;
    *)
      hm_err "Nieznana komenda: ${cmd}. Wpisz 'help'."
      return 1
      ;;
  esac
}

# Tryb jednorazowy: hmtools webs / hmtools use example.com info ...
if [[ "${1:-}" == "-c" ]]; then
  shift
  hm_log_session_start "oneshot"
  set +e
  # shellcheck disable=SC2068
  hm_dispatch $@
  rc=$?
  set -e
  [[ "${rc}" -ne 98 ]] && hm_log_session_end
  [[ "${rc}" -eq 99 || "${rc}" -eq 98 ]] && exit 0
  exit "${rc}"
fi

if [[ $# -gt 0 ]]; then
  hm_log_session_start "oneshot"
  set +e
  hm_dispatch "$@"
  rc=$?
  set -e
  [[ "${rc}" -ne 98 ]] && hm_log_session_end
  if [[ "${rc}" -eq 99 || "${rc}" -eq 98 ]]; then
    exit 0
  fi
  exit "${rc}"
fi

hm_log_session_start "interactive"
hm_setup_readline_complete
# cache domen na start — Tab nie czeka na discovery (i nie gubi promptu)
hm_ensure_sites_cached
hm_ok "hmtools — panel=${PANEL} webserver=${WEBSERVER} db=${DB_ENGINE}"
hm_info "Wpisz 'help' aby zobaczyć komendy. 'exit' kończy. Tab — uzupełnianie (np. use <domena>)."
hm_info "Logi: ${LOG_DIR}/hmtools-$(date +%Y-%m-%d).log"
hm_welcome_update_notice

while true; do
  # Prompt MUSI być w read -p (readline), nie osobnym printf —
  # wtedy Tab/bind -x zawsze przerysowuje hmtools> / [domena]> wraz z linią.
  if ! read -r -e -p "$(hm_prompt_for_read)" line; then
    echo
    break
  fi
  # trim
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  [[ -z "${line}" ]] && continue

  history -s "${line}" 2>/dev/null || true

  set +e
  # shellcheck disable=SC2086
  hm_dispatch ${line}
  rc=$?
  set -e
  if [[ "${rc}" -eq 99 ]]; then
    break
  fi
  if [[ "${rc}" -eq 98 ]]; then
    # uninstall-hmtools — nie zapisuj logu do już usuniętego katalogu
    exit 0
  fi
done

hm_info "Do widzenia."
hm_log_session_end
