#!/usr/bin/env bash
# hmtools — interaktywny shell narzędzi VPS (OpenLiteSpeed / CyberPanel)
set -euo pipefail

# Rozwiąż katalog instalacji (symlink-safe)
_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${_SOURCE}" ]]; do
  _DIR="$(cd "$(dirname "${_SOURCE}")" && pwd)"
  _SOURCE="$(readlink "${_SOURCE}")"
  [[ "${_SOURCE}" != /* ]] && _SOURCE="${_DIR}/${_SOURCE}"
done
_BIN_DIR="$(cd "$(dirname "${_SOURCE}")" && pwd)"
HMTOOLS_ROOT="$(cd "${_BIN_DIR}/.." && pwd)"
export HMTOOLS_ROOT
export HMTOOLS_CONF="${HMTOOLS_CONF:-${HMTOOLS_ROOT}/config/hmtools.conf}"

# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/lib/common.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/lib/help.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/lib/complete.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/lib/detect.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/lib/pkg.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/lib/os_family.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/lib/size.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/lib/db.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/lib/ols.sh"
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/lib/rclone_drive.sh"
# Moduły narzędzi (backup/sites/php/… + plugin dispatch)
# shellcheck disable=SC1091
source "${HMTOOLS_ROOT}/commands/_load.sh"

hm_require_root
hm_load_config
hm_detect_all
hm_log_init

hm_dispatch() {
  local cmd="${1:-}"
  shift || true

  if [[ -n "${cmd}" ]]; then
    hm_log_cmd "${cmd}${*:+ $*}"
  fi

  # pusta linia / exit — rdzeń (nie są narzędziami-modułami)
  case "${cmd}" in
    "") return 0 ;;
    exit|quit|q) return 99 ;;
  esac

  # Niewspierany OS — whitelist z HM_CMD_RESTRICTED (moduł)
  if [[ "${HMTOOLS_RESTRICTED:-0}" -eq 1 ]] && ! hm_dispatch_allowed_when_restricted "${cmd}"; then
    hm_err "System nieobsługiwany (${OS_PRETTY:-${OS_ID:-unknown}}). Dozwolone: uninstall-hmtools, help, version, detect, exit."
    hm_info "Bypass (na własne ryzyko): ALLOW_UNSUPPORTED_OS=1 w ${HMTOOLS_CONF:-hmtools.conf}"
    return 1
  fi

  # Kontekst strony — lokalne handlery (site + wyjątki)
  if [[ -n "${HM_SITE_DOMAIN:-}" ]]; then
    local _hm_site_rc=0
    hm_site_try_dispatch "${cmd}" "$@" || _hm_site_rc=$?
    if [[ "${HM_SITE_DISPATCH_HIT:-0}" -eq 1 ]]; then
      return "${_hm_site_rc}"
    fi
  fi

  hm_cmd_invoke "${cmd}" "$@"
}

# Tryb jednorazowy: hmtools -c "backup prune --yes" / hmtools webs …
# Po -c jeden zacytowany argument ze spacjami → rozbij jak w REPL (cron: hmtools -c "…")
if [[ "${1:-}" == "-c" ]]; then
  shift
  hm_log_session_start "oneshot"
  # bez 'local' — jesteśmy poza funkcją (set -e + local = crash)
  _t0="$(date +%s)"
  rc=0
  _c_args=()
  if [[ $# -eq 1 ]]; then
    set -f
    # shellcheck disable=SC2206
    _c_args=( $1 )
    set +f
  else
    _c_args=( "$@" )
  fi
  set +e
  hm_dispatch "${_c_args[@]}"
  rc=$?
  set -e
  hm_log_cmd_end "${rc}" "$(( $(date +%s) - _t0 ))"
  [[ "${rc}" -ne 98 ]] && hm_log_session_end
  [[ "${rc}" -eq 99 || "${rc}" -eq 98 ]] && exit 0
  exit "${rc}"
fi

if [[ $# -gt 0 ]]; then
  hm_log_session_start "oneshot"
  # bez 'local' — jesteśmy poza funkcją (set -e + local = crash)
  _t0="$(date +%s)"
  rc=0
  set +e
  hm_dispatch "$@"
  rc=$?
  set -e
  hm_log_cmd_end "${rc}" "$(( $(date +%s) - _t0 ))"
  [[ "${rc}" -ne 98 ]] && hm_log_session_end
  if [[ "${rc}" -eq 99 || "${rc}" -eq 98 ]]; then
    exit 0
  fi
  exit "${rc}"
fi

hm_log_session_start "interactive"
hm_setup_readline_complete
hm_detect_banner
if [[ "${HMTOOLS_RESTRICTED:-0}" -eq 1 ]]; then
  hm_info "Tryb awaryjny — możesz odinstalować: uninstall-hmtools"
  hm_info "Logi: ${LOG_DIR}/hmtools-$(date +%Y-%m-%d).log"
else
  # cache domen na start — Tab nie czeka na discovery (i nie gubi promptu)
  hm_ensure_sites_cached
  hm_info "Wpisz 'help' aby zobaczyć komendy. 'exit' kończy. Tab — uzupełnianie (np. use <domena>)."
  hm_info "Logi: ${LOG_DIR}/hmtools-$(date +%Y-%m-%d).log"
  hm_welcome_update_notice
fi
# welcome przez tee — potem TTY na prompt (bez wyścigu z asynchronicznym tee)
hm_log_detach_output_capture

while true; do
  # Prompt na prawdziwym TTY (po detach) — Tab/readline działają poprawnie
  _prompt="$(hm_prompt_for_read)"
  if [[ "${HMTOOLS_RESTRICTED:-0}" -eq 1 ]]; then
    _prompt="hmtools[unsupported]> "
  fi
  if ! read -r -e -p "${_prompt}" line; then
    echo
    break
  fi
  # trim
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  [[ -z "${line}" ]] && continue

  history -s "${line}" 2>/dev/null || true

  # rozbijanie słów BEZ rozwijania globów (*, ?, [...]) względem CWD
  _args=()
  set -f
  # shellcheck disable=SC2206
  _args=( ${line} )
  set +f

  # bez 'local' — pętla REPL jest na poziomie top-level skryptu
  _t0="$(date +%s)"
  _dur=0
  rc=0
  hm_log_attach_output_capture
  set +e
  hm_dispatch "${_args[@]}"
  rc=$?
  set -e
  hm_log_detach_output_capture
  _dur="$(( $(date +%s) - _t0 ))"
  hm_log_cmd_end "${rc}" "${_dur}"
  if [[ "${rc}" -eq 99 ]]; then
    break
  fi
  if [[ "${rc}" -eq 98 ]]; then
    # uninstall-hmtools — nie zapisuj logu do już usuniętego katalogu
    exit 0
  fi
done

hm_info "Do widzenia."
hm_log_session_end
