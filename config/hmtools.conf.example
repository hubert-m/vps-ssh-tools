# Konfiguracja hmtools — skopiuj do hmtools.conf i dostosuj.
# Lokalizacja na serwerze: /hm-tools/config/hmtools.conf

# --- Katalogi stron (opcjonalnie) ---
# Gdy vhosty nie są w /home/* ani /var/www/*, ustaw root (np. /srv/www).
# Używane m.in. przez webs delete / ols cache flush.
# SITES_ROOT="/srv/www"

# --- Nadpisanie auto-detekcji stosu (detect) ---
# Gdy hmtools źle rozpozna panel/WWW/DB — ustaw ręcznie (po hm_detect_all):
# FORCE_PANEL="cyberpanel"          # cyberpanel|cpanel|plesk|webmin|directadmin|aapanel|unknown
# FORCE_WEBSERVER="openlitespeed"   # openlitespeed|nginx|apache|litespeed|unknown
# FORCE_DB_ENGINE="mariadb"         # mariadb|mysql|unknown
# FORCE_PKG_MANAGER="dnf"           # apt|dnf|yum — wymuszenie adaptera pakietów (testy)
# FORCE_SUPERVISOR="yes"            # yes|no — wymuszenie wyniku detekcji Supervisor
# FORCE_DOCKER="yes"                # yes|no — wymuszenie wyniku detekcji Docker
# FORCE_CHROME_BIN="/usr/bin/google-chrome-stable"  # wymusza CHROME=yes + ścieżkę binarki
# FORCE_CHROME_CDP="http://127.0.0.1:9222"          # lub samo 9222 — DevTools headless daemona
# Gdy OS nie jest na liście wsparcia (Ubuntu/Debian/Alma/Rocky/CentOS/RHEL),
# hmtools wchodzi w tryb awaryjny (tylko uninstall-hmtools). Bypass:
# ALLOW_UNSUPPORTED_OS=1

# --- Google Drive (rclone) ---
# Root katalogu na kopie zapasowe: remote:ścieżka
# Ustaw jednorazowo:  hmtools → backup config   lub   backup setup
#
# Struktura wewnątrz root:
#   full/<stamp>/           — pełne kopie serwera
#   <domena>/<stamp>/       — kopie poszczególnych stron
#   db-dumps/               — jednorazowe zrzuty mysql dump
#
# Przykład: gdrive:vps-backups
RCLONE_REMOTE="gdrive:vps-backups"

# Minimalny wolny procent dysku przed backupem (abort jeśli mniej)
MIN_FREE_PERCENT=5

# Rozmiar chunka (MB) przy trybie split (gdy stream rcat niedostępny / bardzo duże drzewa)
CHUNK_SIZE_MB=512

# Próg rozmiaru (MB), powyżej którego używany jest tryb chunk zamiast pojedynczego rcat
CHUNK_THRESHOLD_MB=2048

# Katalog tymczasowy (musi być 0700, właściciel = root/euid, NIE symlink).
# Domyślnie /var/lib/hmtools/tmp (poza world-writable /tmp). Unikaj /tmp/hmtools-backup.
TMP_DIR="/var/lib/hmtools/tmp"

# Wykluczenia tar dla backup site/full (kotwiczone ./ — nie kasują głębokich tmp/.git)
BACKUP_EXCLUDES="./node_modules ./.git ./tmp ./temp ./cache ./public_html/wp-content/cache ./public_html/wp-content/uploads/cache *.log"
# Archive (przed usunięciem z VPS): domyślnie puste = pełny dump; nie dziedziczy BACKUP_EXCLUDES
# ARCHIVE_EXCLUDES=""

# Etykieta hosta w manifestach JSON (domyślnie: hostname -f)
# BACKUP_HOST_LABEL=""

# Retencja kopii na Google Drive (backup prune)
# Usuwaj snapshoty starsze niż N dni (zawsze zostaw BACKUP_KEEP_MIN najnowszych na katalog)
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MIN=3
# Niepełne snapshoty młodsze niż N godzin nie są kasowane przez prune (ochrona trwającego backupu)
BACKUP_ORPHAN_GRACE_HOURS=24
# Opcjonalne szyfrowanie klienta (openssl AES-256-CBC) dla db-accounts / unix-account / system-configs
# BACKUP_ENCRYPT_PASSPHRASE="zmień-mnie"

# Harmonogram (backup schedule enable) → /etc/cron.d/hmtools-backup
# Godzina codziennego backup full (0–23); prune godzinę później gdy =1
BACKUP_SCHEDULE_HOUR=3
BACKUP_SCHEDULE_PRUNE=1
# Po udanym backup full też wyślij powiadomienie (domyślnie tylko błędy)
# BACKUP_NOTIFY_SUCCESS=0

# --- Powiadomienia (notify / health watch / backup) ---
# E-mail przez sendmail/msmtp (Postfix CyberPanel) i/lub webhook JSON (Slack/Discord/ntfy)
# NOTIFY_EMAIL="admin@example.com"
# NOTIFY_WEBHOOK_URL="https://hooks.example.com/…"   # nigdy nie logowany w applog
# NOTIFY_FROM="hmtools@hostname"
# NOTIFY_DEDUP_HOURS=24
# NOTIFY_STATE_DIR="/var/lib/hmtools/notify"
# HEALTH_WATCH_DISK=90
# HEALTH_WATCH_SSL_DAYS=14

# --- Logi pracy hmtools ---
# 1 = włączone, 0 = wyłączone
LOG_ENABLED=1
# Katalog logów (absolutny lub względem /hm-tools)
LOG_DIR="/hm-tools/logs"
# Usuwaj pliki starsze niż N dni (0 = nie czyść)
LOG_RETENTION_DAYS=30
# Minimalny poziom zapisu: DEBUG | INFO | WARN | ERROR
LOG_LEVEL="INFO"
# 1 = kopiuj cały stdout/stderr sesji do logu (tabele, odpowiedzi, output komend)
LOG_CAPTURE_OUTPUT=1
# Limit linii outputu z hm_run (0 = bez limitu)
LOG_RUN_MAX_LINES=400
